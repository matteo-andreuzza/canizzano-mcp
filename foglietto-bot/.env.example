# ---------------------------------------------------------------------------
# foglietto-bot — configurazione
# Copiare in «.env» e riempire. Il file .env non va mai committato.
# ---------------------------------------------------------------------------

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
# Modello con capacita' di visione, legge il PDF scansionato pagina per pagina.
GEMINI_MODEL=gemini-3.5-flash
# Piu' bassa = piu' letterale. L'estrazione di fatti non vuole fantasia.
GEMINI_TEMPERATURA=0.15

# --- Server MCP del CMS ---------------------------------------------------
# Il CMS gira sulla stessa macchina: JSON-RPC 2.0 puro su POST, senza sessioni.
MCP_URL=http://localhost:8000/mcp/
# Chiave dedicata a questo bot, creata in admin -> Assistente AI.
# DEVE essere senza permesso di eliminazione (vedi README).
MCP_KEY=

# --- Cartelle sul Raspberry Pi -------------------------------------------
# Dove lo scraper deposita le scansioni del foglietto (un PDF per settimana).
CARTELLA_FOGLIETTI=/home/pi/foglietto-bot/foglietti
# Registro dei PDF gia' processati, copie dei report, log.
CARTELLA_STATO=/home/pi/foglietto-bot/stato

# --- Posta ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_MITTENTE=
# 465 -> SSL implicito; 587 -> STARTTLS. Vale solo se non e' gia' dedotto.
SMTP_TLS=starttls

# Destinatario del report settimanale.
EMAIL_DESTINATARIO=matteoandreuzza@outlook.it

# --- Soglie e parametri da ritoccare nel tempo ----------------------------
# Realta' su cui ripiegare quando il modello non riesce a decidere: il
# contenuto viene comunque creato in bozza, col dubbio scritto nel report.
ATTIVITA_PREDEFINITA=parrocchia
# Sotto questa confidenza il contenuto si crea comunque, ma resta in bozza.
SOGLIA_PUBBLICAZIONE=0.80
# Somiglianza fra titoli oltre la quale due eventi sono considerati lo stesso.
SOGLIA_DUPLICATO=0.82
# Finestra (giorni, prima e dopo la data dell'evento) in cui cercare duplicati.
GIORNI_DEDUP=21
# Quante volte ritentare un PDF che ha dato errore prima di lasciarlo perdere.
MAX_TENTATIVI=3
# Secondi da aspettare dopo l'ultima modifica di un PDF prima di leggerlo:
# evita di analizzare un file che lo scraper sta ancora scrivendo.
ETA_MINIMA_PDF=60
# Se acceso non scrive nulla nel CMS: analizza, simula, manda il report.
DRY_RUN=0
LOG_LEVEL=INFO
