# Copia in monitor/.env. Password della dashboard (l'utente e' libero):
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MONITOR_TOKEN=
# 127.0.0.1 per raggiungerla solo via tunnel ssh / reverse proxy.
MONITOR_BIND=0.0.0.0
MONITOR_PORTA=8090
# Stessa cartella logs/ del repository del sito (quella del bot).
CARTELLA_LOG_SITO=/percorso/assoluto/a/canizzano/logs
NOME_RETE_CONDIVISA=canizzano_rete
# Utente con cui girano i comandi dentro al bot (uid:gid dell'host).
UTENTE_BOT=1000:1000
