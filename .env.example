# ---------------------------------------------------------------------------
# foglietto-bot — configurazione dello stack Docker (compose.yaml alla radice)
# Copiare in «.env», nella stessa cartella, e riempire. Non va mai committato.
#
# Per l'uso da terminale senza Docker (venv, systemd sul Pi) la configurazione
# resta in foglietto-bot/.env — vedi foglietto-bot/.env.example.
# ---------------------------------------------------------------------------

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
# Modello con capacita' di visione, legge il PDF scansionato pagina per pagina.
GEMINI_MODEL=gemini-3.5-flash
# Piu' bassa = piu' letterale. L'estrazione di fatti non vuole fantasia.
GEMINI_TEMPERATURA=0.15

# --- Server MCP del CMS (repository «canizzano») ---------------------------
# Il CMS gira nel suo stack Docker, servizio «backend»: qui si usa il nome del
# servizio, non «localhost», perche' i due stack si parlano sulla rete Docker
# condivisa (vedi NOME_RETE_CONDIVISA piu' sotto), non attraverso l'host.
MCP_URL=http://backend:8000/mcp/
# Chiave dedicata a questo bot, creata in admin -> Assistente AI -> chiavi
# dell'assistente (o con `./canizzano.sh mcp --nuova --nome "foglietto-bot"`
# nel repository del sito). Lasciala SENZA la spunta «sola lettura» — deve
# scrivere — ma trattala come una password: e' l'unica chiave di questo bot,
# revocabile da sola senza toccare le altre.
MCP_KEY=

# --- Posta ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_MITTENTE=
# 465 -> SSL implicito; 587 -> STARTTLS. Vale solo se non e' gia' dedotto.
SMTP_TLS=starttls
# Destinatario del report di ogni esecuzione (anche quando non c'e' stato
# niente da fare, o qualcosa e' andato storto).
EMAIL_DESTINATARIO=matteoandreuzza@outlook.it

# --- L'endpoint /attiva (bottone «Elabora il foglietto» nella dashboard) ---
# Porta interna su cui il container ascolta. Non e' mai pubblicata sull'host
# (vedi "expose:" in compose.yaml, non "ports:"): la raggiunge solo chi sta
# sulla stessa rete Docker condivisa, cioe' l'esecutore del sito.
ATTIVA_PORTA=8088
# Token condiviso col sito: qui e nel suo .env (BOT_FOGLIETTO_TOKEN) deve
# comparire la STESSA stringa. Generane una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ATTIVA_TOKEN=

# --- Rete Docker condivisa con lo stack del sito ----------------------------
# Creata una tantum, prima del primo avvio: `docker network create <nome>`.
# Deve comparire IDENTICA in questo file e nel .env del repository del sito.
NOME_RETE_CONDIVISA=canizzano_rete

# --- Bind mount: percorsi sull'HOST -----------------------------------------
# Dove il container legge/scrive fuori da se stesso. I percorsi dentro al
# container sono fissi (vedi Dockerfile) e non si toccano: qui si dice solo
# dove stanno sul disco della macchina che fa girare Docker.
#
# PDF scaricati (archivio) e stato di idempotenza (registro, lucchetto, copie
# dei report): relativi a questa cartella vanno benissimo, di norma non serve
# toccarli.
CARTELLA_FOGLIETTI_HOST=./foglietti
CARTELLA_STATO_HOST=./stato
#
# Il container gira con questo uid/gid (non root), cosi' i file che scrive nei
# bind mount qui sopra restano di proprieta' di chi lancia `docker compose
# up`. 1000:1000 va bene quasi ovunque; se il tuo utente ha un altro id
# (`id -u`, `id -g`), scommenta e correggi:
# UID_HOST=1000
# GID_HOST=1000
#
# OBBLIGATORIO: percorso assoluto della cartella «logs/» del repository del
# sito (quella con attivita.log). E' il registro che la dashboard mostra sotto
# «Ultime attivita'»: senza, il container non parte (compose.yaml lo richiede
# esplicitamente). Esempio:
CARTELLA_LOG_SITO=/percorso/assoluto/a/canizzano/logs

# --- Soglie e parametri da ritoccare nel tempo ------------------------------
# Realta' su cui ripiegare quando il modello non riesce a decidere: il
# contenuto viene comunque creato in bozza, col dubbio scritto nel report.
ATTIVITA_PREDEFINITA=parrocchia
# Sotto questa confidenza il contenuto si crea comunque, ma resta in bozza.
SOGLIA_PUBBLICAZIONE=0.80
# Somiglianza fra titoli oltre la quale due eventi sono considerati lo stesso.
SOGLIA_DUPLICATO=0.82
# Finestra (giorni, prima e dopo la data dell'evento) in cui cercare duplicati.
GIORNI_DEDUP=21
# Quante volte ritentare un PDF che ha dato errore prima di lasciarlo perdere.
MAX_TENTATIVI=3
# Secondi da aspettare dopo l'ultima modifica di un PDF prima di leggerlo:
# evita di analizzare un file che lo scraper sta ancora scrivendo.
ETA_MINIMA_PDF=60
# Se acceso non scrive nulla nel CMS: analizza, simula, manda il report.
DRY_RUN=0
LOG_LEVEL=INFO

TZ=Europe/Rome
